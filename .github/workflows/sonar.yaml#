name: SonarQube
on:
  push:
    branches:
      - main
  pull_request:
    types: [opened, synchronize, reopened]
  workflow_dispatch: 
jobs:
  build:
    # name: Analyze
    # runs-on: ubuntu-latest
    # steps:
    #   - uses: actions/checkout@34e114876b0b11c390a56381ad16ebd13914f8d5 # v4.3.1
    #     with:
    #       fetch-depth: 0  # Shallow clones should be disabled for a better relevancy of analysis
    #   - name: SonarQube Scan
    #     uses: SonarSource/sonarqube-scan-action@7006c4492b2e0ee0f816d36501671557c97f5995 # v8.1.0
    #     env:
    #       SONAR_TOKEN: ${{ secrets.SONAR_TOKEN }}
    name: Build and analyze
    runs-on: ubuntu-latest
    env:
      BUILD_WRAPPER_OUT_DIR: build_wrapper_output_directory # Directory where build-wrapper output will be placed
    steps:
      - uses: actions/checkout@34e114876b0b11c390a56381ad16ebd13914f8d5 # v4.3.1
        with:
          fetch-depth: 0  # Shallow clones should be disabled for a better relevancy of analysis
      - name: Install Build Wrapper
        uses: SonarSource/sonarqube-scan-action/install-build-wrapper@7006c4492b2e0ee0f816d36501671557c97f5995 # v8.1.0
      - name: Configure build
        run: |
          sudo apt-get update
          sudo apt-get install -y meson ninja-build clang python3-dev libpcap-dev
          meson setup build-sonar -Dbuildtype=debug
      - name: Run Build Wrapper
        run: |
          build-wrapper-linux-x86-64 \
            --out-dir "${{ env.BUILD_WRAPPER_OUT_DIR }}" \
            meson compile -C build-sonar
      - name: Check compilation database
        run: |
          test -s "${{ env.BUILD_WRAPPER_OUT_DIR }}/compile_commands.json"
          grep -n "pcap.c" "${{ env.BUILD_WRAPPER_OUT_DIR }}/compile_commands.json"
      - name: SonarQube Scan
        uses: SonarSource/sonarqube-scan-action@7006c4492b2e0ee0f816d36501671557c97f5995 # v8.1.0
        env:
          SONAR_TOKEN: ${{ secrets.SONAR_TOKEN }}
        with:
          args: >
            --define "sonar.cfamily.compile-commands=${{ env.BUILD_WRAPPER_OUT_DIR }}/compile_commands.json"
